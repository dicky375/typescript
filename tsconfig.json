{
  "compilerOptions": {
     "target": "es2022",
     "module": "es2022",
     "moduleResolution": "bundler",
     "strict": true,
     "noUncheckedIndexedAccess": true,
     "exactOptionalPropertyTypes": true,
     "useUnknownInCatchVariables": true,
     "skipLibCheck": true,
     "rootDir": "src",
     "outDir": "./dist",
     "jsx": "react-jsx",
     "allows": true

     

  },
  "include" : ["src", "typescript/src/components"],
  "exclude": ["node_modules"]
}