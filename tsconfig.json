{
  "compilerOptions": {
     "target": "es2022",
     "module": "es2022",
     "moduleResolution": "bundler",
     "strict": true,
     "naUncheckedIndexedAccess": true,
     "exactOptionalPropertyTypes": true,
     "useUnknownInCatchVariables": true,
     "skipLibCheck": true,
     "rootDir": "src",
     "outDir": "dist"

  },
  "include" : ["src"]
}